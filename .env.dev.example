# What `pnpm dev:setup` keeps in the shared development env file: the PRIMARY
# checkout's .env (set MEDIABINDER_DEV_ENV_FILE to use another). Every
# worktree's `pnpm dev:docker` reads it, so a new worktree needs no setup.
#
# dev:setup creates the file when missing, or adds only the keys that are
# absent. It never changes a value that is already there. This file is the
# documentation; the script holds the same list.
#
# Stack-specific values (MEDIABINDER_URL, the port, the database host) come
# from compose.dev.yaml and the script, not from here.

# Turns on "Skip login for development" and the developer user. Honoured only
# when NODE_ENV is not "production", so the production image ignores it.
MEDIABINDER_ENVIRONMENT=dev

# Generated by dev:setup.
BETTER_AUTH_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Optional: sign in with a real Google account.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: shared-folder Drive access. The path of the service account's JSON
# key on THIS machine; quote it if it has spaces. The stack mounts it
# read-only at /run/secrets/mediabinder-drive-sync.json and sets
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE to that path.
# GOOGLE_SERVICE_ACCOUNT_KEY_HOST_FILE="/absolute/path/to/service-account.json"
# Google Picker (needs a real Google sign-in; skip login has no Google token).
# GOOGLE_PICKER_API_KEY=
# GOOGLE_CLOUD_PROJECT_NUMBER=

# Optional: a Drive folder shared with the service account. On start it is
# linked for the developer and one initial sync is queued. Needs the key above.
# MEDIABINDER_DEV_FOLDER_ID=drive-folder-id
