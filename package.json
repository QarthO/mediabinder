{
  "name": "mediabinder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vp dev --host 0.0.0.0 --port 3100",
    "build": "vp build",
    "start": "node scripts/serve.mjs",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "db:migrate": "tsx scripts/migrate.ts",
