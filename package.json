    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "better-auth": "~1.6.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "4.1.4",
    "lucide-react": "^1.72.0",
    "mysql2": "^3.24.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
