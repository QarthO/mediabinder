# Copy to .env; keep credentials out of version control.
MEDIABINDER_URL=http://localhost:3100
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOW_SIGNUPS=false
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
DATABASE_URL=mysql://mediabinder:replace-with-a-random-database-password@mysql:3306/mediabinder

# Google push notifications automatically use MEDIABINDER_URL + /api/drive/webhook
# on public HTTPS deployments. Optional override (for example an HTTPS tunnel):
# DRIVE_WEBHOOK_URL=https://media.example.com/api/drive/webhook

# Optional OTLP HTTP/JSON endpoint for thumbnail Effect spans
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://collector:4318/v1/traces

# Standalone Docker / Coolify: use these instead of DATABASE_URL.
# DB_HOST=your-mysql-internal-hostname
# DB_NAME=mediabinder
# DB_USER=mediabinder
# DB_PASS=your-database-password
# DB_PORT=3306
# BETTER_AUTH_URL remains a fallback if MEDIABINDER_URL is unset.
# The standalone image starts its Drive worker automatically.
# DRIVE_WORKER_ENABLED=false
